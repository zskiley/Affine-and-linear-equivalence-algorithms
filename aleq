#!/bin/sh
set -eu

root=$(CDPATH= cd "$(dirname "$0")" && pwd)
build="$root/build"
build_log="$build/.aleq-build.log"

run_quietly() {
    if ! "$@" >"$build_log" 2>&1; then
        cat "$build_log" >&2
        rm -f "$build_log"
        return 1
    fi
}

if [ ! -f "$build/CMakeCache.txt" ]; then
    mkdir -p "$build"
    run_quietly cmake -S "$root" -B "$build" -DCMAKE_BUILD_TYPE=Release
fi
run_quietly cmake --build "$build" --config Release --target aleq --parallel
rm -f "$build_log"

exe=
if [ -x "$build/aleq.exe" ]; then
    exe="$build/aleq.exe"
elif [ -x "$build/Release/aleq.exe" ]; then
    exe="$build/Release/aleq.exe"
elif [ -x "$build/aleq" ]; then
    exe="$build/aleq"
elif [ -x "$build/Release/aleq" ]; then
    exe="$build/Release/aleq"
else
    echo "error: built aleq executable was not found" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "Built aleq: $exe"
    exit 0
fi

exec "$exe" "$@"
